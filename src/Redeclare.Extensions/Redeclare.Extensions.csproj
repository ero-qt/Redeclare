<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Redeclare</RootNamespace>
  </PropertyGroup>

  <Import Project="Package.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <!-- The conveniences extend Redeclare's internal types, so the core sources compile in here the way they compile
       into a consumer. They are not packed: a consumer references both packages. -->
  <ItemGroup>
    <Compile Include="$(SrcPath)/Redeclare/**/*.cs" Exclude="$(DefaultItemExcludes)" LinkBase="Redeclare" />
  </ItemGroup>

</Project>
