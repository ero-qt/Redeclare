<Project Sdk="Microsoft.NET.Sdk">

  <!-- A project that uses the generator the way any project would, as an analyzer reference. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../EnumHelpers.Generator/EnumHelpers.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
